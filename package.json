{
    "name": "@openhps/cordova",
    "version": "1.0.0",
    "description": "Open Hybrid Positioning System - Cordova",
    "author": "Maxim Van de Wynckel",
    "license": "Apache-2.0",
    "repository": "https://github.com/OpenHPS/openhps-cordova.git",
    "bugs": {
        "url": "https://github.com/OpenHPS/openhps-cordova/issues"
    },
    "homepage": "https://openhps.org",
    "private": true,
    "workspaces": [
        "./modules/*"
    ],
    "scripts": {
        "build:typedoc": "typedoc --options docs/typedoc.json",
        "clean": "shx rm -rf docs/out && shx rm -rf modules/*/dist && shx rm -rf modules/*/docs/out",
        "lint": "eslint . && node scripts/check-peers.mjs",
        "bump:development": "commit-and-tag-version --prerelease alpha -m 'chore(alpha): %s' --skip.changelog",
        "bump:release": "commit-and-tag-version -m 'chore(release): %s' --skip.changelog",
        "prepare": "husky"
    },
    "devDependencies": {
        "@babel/cli": "^8.1.0",
        "@babel/core": "^8.1.2",
        "@babel/preset-env": "^8.0.7",
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@eslint/js": "^9.39.5",
        "@openhps/core": "^1.0.16",
        "@types/chai": "^5.2.2",
        "@types/cordova": "11.0.3",
        "@types/mocha": "^10.0.10",
        "@types/node": "^26.6.6",
        "chai": "^6.3.0",
        "commit-and-tag-version": "^13.3.0",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsdoc": "^65.4.5",
        "eslint-plugin-prettier": "^5.5.7",
        "globals": "^17.14.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "mocha": "^11.8.0",
        "mocha-junit-reporter": "^2.2.1",
        "npm-run-all": "^4.1.5",
        "nyc": "^18.0.0",
        "prettier": "^3.10.0",
        "reflect-metadata": "^0.2.2",
        "shx": "^0.4.0",
        "terser-webpack-plugin": "^5.3.14",
        "ts-node": "^10.9.2",
        "typedoc": "^0.28.20",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.72.2",
        "webpack": "^5.112.2",
        "webpack-bundle-analyzer": "^5.4.2",
        "webpack-cli": "^7.3.1"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "packageManager": "npm@10.9.2"
}
