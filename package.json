{
    "name": "@openhps/cordova",
    "version": "1.0.0",
    "description": "Open Hybrid Positioning System - Cordova",
    "author": "Maxim Van de Wynckel",
    "license": "Apache-2.0",
    "repository": "https://github.com/OpenHPS/openhps-cordova.git",
    "bugs": {
        "url": "https://github.com/OpenHPS/openhps-cordova/issues"
    },
    "homepage": "https://openhps.org",
    "private": true,
    "workspaces": [
        "./modules/*"
    ],
    "scripts": {
        "build:typedoc": "typedoc --options docs/typedoc.json",
        "clean": "shx rm -rf docs/out && shx rm -rf modules/*/dist && shx rm -rf modules/*/docs/out",
        "lint": "eslint . && node scripts/check-peers.mjs",
        "bump:development": "commit-and-tag-version --prerelease alpha -m 'chore(alpha): %s' --skip.changelog",
        "bump:release": "commit-and-tag-version -m 'chore(release): %s' --skip.changelog",
        "prepare": "husky"
    },
    "devDependencies": {
        "@babel/cli": "^8.0.4",
        "@babel/core": "^8.0.1",
        "@babel/preset-env": "^8.0.2",
        "@commitlint/cli": "^19.8.1",
        "@commitlint/config-conventional": "^19.8.1",
        "@eslint/js": "^9.34.0",
        "@openhps/core": "^1.0.16",
        "@types/chai": "^5.2.2",
        "@types/cordova": "11.0.3",
        "@types/mocha": "^10.0.10",
        "@types/node": "^24.3.0",
        "chai": "^6.2.2",
        "commit-and-tag-version": "^13.1.2",
        "eslint": "^9.34.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsdoc": "^54.1.1",
        "eslint-plugin-prettier": "^5.5.4",
        "globals": "^16.3.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.2.7",
        "mocha": "^11.8.0",
        "mocha-junit-reporter": "^2.2.1",
        "npm-run-all": "^4.1.5",
        "nyc": "^18.0.0",
        "prettier": "^3.9.6",
        "reflect-metadata": "^0.2.2",
        "shx": "^0.4.0",
        "ts-node": "^10.9.2",
        "typedoc": "^0.28.20",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.66.0",
        "webpack": "^5.101.3",
        "webpack-bundle-analyzer": "^5.3.2",
        "webpack-cli": "^7.2.2",
        "terser-webpack-plugin": "^5.3.14"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "packageManager": "npm@10.9.2"
}
